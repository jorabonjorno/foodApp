<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Базовый URL backend-proxy. Пустое значение = Mock mode. Задаётся build setting API_BASE_URL, например https://foodapp-proxy.<you>.workers.dev -->
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<!-- Публичный токен приложения для прокси (не секрет). Build setting API_APP_TOKEN. -->
	<key>APIAppToken</key>
	<string>$(API_APP_TOKEN)</string>
</dict>
</plist>
